{
  "name": "Procurement Red Flags - Editorial",
  "dataColors": ["#3B3F4A", "#8E2A33", "#9C8F7A", "#B9B1A3", "#6E6A62", "#C9BFAE", "#5A4A3A", "#D9D2C5"],
  "background": "#F4F0E8",
  "foreground": "#17181C",
  "tableAccent": "#8E2A33",
  "good": "#3B3F4A",
  "neutral": "#9C8F7A",
  "bad": "#8E2A33",
  "maximum": "#8E2A33",
  "center": "#C9A9A0",
  "minimum": "#F4F0E8",
  "textClasses": {
    "callout": { "fontFace": "Georgia", "fontSize": 30, "color": "#17181C" },
    "title": { "fontFace": "Georgia", "fontSize": 12, "color": "#17181C" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 10, "color": "#6E6A62" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#17181C" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "transparency": 0, "color": { "solid": { "color": "#F4F0E8" } } }],
        "outspace": [{ "color": { "solid": { "color": "#E9E3D8" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": false }],
        "visualHeader": [{ "show": false }],
        "categoryAxis": [{ "labelColor": { "solid": { "color": "#17181C" } }, "gridlineShow": false, "showAxisTitle": false }],
        "valueAxis": [{ "labelColor": { "solid": { "color": "#6E6A62" } }, "gridlineColor": { "solid": { "color": "#D9D2C5" } }, "showAxisTitle": false }],
        "labels": [{ "color": { "solid": { "color": "#17181C" } } }],
        "legend": [{ "labelColor": { "solid": { "color": "#6E6A62" } } }]
      }
    },
    "tableEx": {
      "*": {
        "grid": [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#D9D2C5" } }, "outlineColor": { "solid": { "color": "#D9D2C5" } } }],
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#8E2A33" } }, "backColor": { "solid": { "color": "#F4F0E8" } }, "fontFamily": "Segoe UI Semibold", "outline": "Bottom only" }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#17181C" } }, "backColorPrimary": { "solid": { "color": "#F4F0E8" } }, "fontColorSecondary": { "solid": { "color": "#17181C" } }, "backColorSecondary": { "solid": { "color": "#EEE8DD" } } }],
        "total": [{ "fontColor": { "solid": { "color": "#17181C" } }, "backColor": { "solid": { "color": "#F4F0E8" } } }]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#8E2A33" } }, "backColor": { "solid": { "color": "#F4F0E8" } } }],
        "rowHeaders": [{ "fontColor": { "solid": { "color": "#17181C" } }, "backColor": { "solid": { "color": "#F4F0E8" } } }],
        "values": [{ "fontColorPrimary": { "solid": { "color": "#17181C" } }, "backColorPrimary": { "solid": { "color": "#F4F0E8" } }, "backColorSecondary": { "solid": { "color": "#EEE8DD" } } }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "fontColor": { "solid": { "color": "#17181C" } }, "background": { "solid": { "color": "#F4F0E8" } } }],
        "header": [{ "fontColor": { "solid": { "color": "#6E6A62" } } }]
      }
    },
    "cardVisual": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
